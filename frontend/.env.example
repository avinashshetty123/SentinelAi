# Public configuration only: NEXT_PUBLIC_* values are embedded in the browser bundle.
# NEVER put secrets (e.g. GROQ_API_KEY) in any NEXT_PUBLIC_ variable.

# FastAPI base URL including the /api/v1 prefix.
# Local:      http://localhost:8000/api/v1
# Production: https://<your-render-service>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: override the WebSocket URL (defaults to NEXT_PUBLIC_API_URL with ws(s):// + /ws/events)
NEXT_PUBLIC_WS_URL=

# ---------------------------------------------------------------------------
# SentinelAI backend configuration (copy to .env and fill in). NEVER commit .env.
# ---------------------------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL. postgres:// and postgresql:// URLs are accepted and normalized to the asyncpg driver.
# Local (docker compose maps Postgres to host port 5432):
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# --- VirusTotal URL reputation (optional; offline analysis still works without it) ---
# Get a free API key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLED=true
VIRUSTOTAL_TIMEOUT_SECONDS=8

# --- Groq LLM (optional; the scanner works without it) ---
GROQ_API_KEY=
# Groq production model with strict structured-output support
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ENABLED=true
GROQ_TIMEOUT_SECONDS=12
GROQ_MAX_RETRIES=1
GROQ_REQUESTS_PER_MINUTE=20
GROQ_MAX_INPUT_CHARS=4000
GROQ_REASONING_EFFORT=low

# --- HTTP / security ---
# Comma-separated list of allowed browser origins (your Vercel URL in production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for preview deployments, e.g. ^https://sentinelai-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=
# true behind Render/another reverse proxy
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BYTES=65536

# Auth: "open" (no credentials; refused when APP_ENV=production unless acknowledged) or
# "token" (all non-health endpoints require Authorization: Bearer <ADMIN_API_TOKEN>).
AUTH_MODE=open
# >= 24 random characters when AUTH_MODE=token
ADMIN_API_TOKEN=
ALLOW_OPEN_MODE_IN_PRODUCTION=false

# --- Rate limiting (per client IP, per minute) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCANS_PER_MINUTE=30
RATE_LIMIT_WRITES_PER_MINUTE=60
RATE_LIMIT_READS_PER_MINUTE=300

# --- Privacy & retention ---
# store short evidence excerpts with findings
STORE_FINDING_EXCERPTS=false
# store LLM-written summaries with scans
STORE_AI_SUMMARIES=false
SCAN_RETENTION_DAYS=30
EVENT_HISTORY_MAX=5000

# --- Detection / scoring ---
RISK_THRESHOLD_MEDIUM=25
RISK_THRESHOLD_HIGH=50
RISK_THRESHOLD_CRITICAL=75
# scans at/above this level publish a security event
EVENT_MIN_LEVEL=HIGH
# LOW|MEDIUM|HIGH|CRITICAL|NONE
AUTO_INCIDENT_MIN_LEVEL=CRITICAL
CLASSIFIER_ENABLED=true

# --- Demo ---
DEMO_MODE_ENABLED=true
DEMO_STEP_DELAY_SECONDS=1.2
DEMO_SIMULATOR_MAX_SECONDS=300

# Container only
RUN_MIGRATIONS_ON_START=true
